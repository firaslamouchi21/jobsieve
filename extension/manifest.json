{
  "manifest_version": 3,
  "name": "Jobsieve Capture",
  "version": "2.0.0",
  "description": "Save the job page you are looking at to your own local Jobsieve app. Reads a page only when you click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": { "default_title": "Save this job to Jobsieve", "default_popup": "popup.html" },
  "browser_specific_settings": { "gecko": { "id": "capture@jobsieve.local", "strict_min_version": "115.0" } }
}
